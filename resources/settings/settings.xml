<settings>
    <setting propertyKey="@Properties.routeString" title="@Strings.RouteStringTitle" prompt="@Strings.RouteStringPrompt">
        <settingConfig type="alphaNumeric" maxLength="2048" />
    </setting>
    <setting propertyKey="@Properties.mapRange" title="@Strings.MapRangeTitle" prompt="@Strings.MapRangePrompt">
        <settingConfig type="numeric" min="50" max="1000" errorMessage="@Strings.MapRangeError" />
    </setting>
    <setting propertyKey="@Properties.routeDirection" title="@Strings.RouteDirectionTitle" prompt="@Strings.RouteDirectionPrompt">
        <settingConfig type="list">
            <listEntry value="0">@Strings.DirectionForward</listEntry>
            <listEntry value="1">@Strings.DirectionReverse</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.showDirection" title="@Strings.ShowDirectionTitle" prompt="@Strings.ShowDirectionPrompt">
        <settingConfig type="boolean" />
    </setting>
    <setting propertyKey="@Properties.dimCompletedPath" title="@Strings.DimCompletedPathTitle" prompt="@Strings.DimCompletedPathPrompt">
        <settingConfig type="boolean" />
    </setting>
    <setting propertyKey="@Properties.showTurnCue" title="@Strings.ShowTurnCueTitle" prompt="@Strings.ShowTurnCuePrompt">
        <settingConfig type="boolean" />
    </setting>
    <setting propertyKey="@Properties.showCornerAnchors" title="@Strings.ShowCornerAnchorsTitle" prompt="@Strings.ShowCornerAnchorsPrompt">
        <settingConfig type="boolean" />
    </setting>
</settings>

